{
  "name": "dao-proxy-min",
  "displayName": "道Agent · 反者道之动 · 弱者道之用",
  "description": "v9.9.76 · 方言镜像·道法自然(主公诏:141 zhou 新版Devin登录即崩根治): 新版Devin走Connect协议(application/proto)·旧代理兜底恒答application/grpc→ConnectError→登录崩;今以来者方言镜像应答+铸令类RPC诚实unavailable+last-good回放线族校验+服务名包级前缀动态适配+裸502净衣+grpc-web/connect+json族内子类镜像 + 承v9.9.75 子代理一族SP尽道",
  "version": "9.9.76",
  "publisher": "dao-agi",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dao-genesis/windsurf-assistant.git"
  },
  "homepage": "https://github.com/dao-genesis/windsurf-assistant",
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "windsurf",
    "devin",
    "cascade",
    "system-prompt",
    "dao",
    "proxy",
    "minimal",
    "道德经",
    "反代",
    "essence"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "dao-proxy-min runs in all workspaces"
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dao-container",
          "title": "道Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dao-container": [
        {
          "id": "dao.essence",
          "name": "本源观照",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "wam.originInvert",
        "title": "道Agent: 启 (invert · 道德经前置 · 彻删官方着相)",
        "category": "道Agent"
      },
      {
        "command": "wam.originPassthrough",
        "title": "官方Agent: 启 (passthrough · 锚归云 · 直连)",
        "category": "道Agent"
      },
      {
        "command": "dao.toggleMode",
        "title": "道Agent: 切换模式 (道 ⇄ 官方)",
        "category": "道Agent"
      },
      {
        "command": "dao.openPreview",
        "title": "道Agent: 浏览器观真 SP (/origin/preview)",
        "category": "道Agent"
      },
      {
        "command": "wam.verifyEndToEnd",
        "title": "全链路自检 (E2E)",
        "category": "道Agent"
      },
      {
        "command": "wam.selftest",
        "title": "闭环自检 (L0+L1+L2 · 线上真值)",
        "category": "道Agent"
      }
    ],
    "configuration": {
      "title": "道Agent",
      "properties": {
        "dao.origin.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "源.js 反代端口 (0=自动 per-user FNV-1a hash · 8889..8988 · 多账号自然隔离). 非0则覆盖."
        },
        "dao.origin.acpPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Devin Local(acp) 专属口 (0=自动=主口-500 · 8389..8488 · 两面分治之脊: acp 请求归 local 面 · 非0则覆盖)."
        },
        "dao.origin.defaultMode": {
          "type": "string",
          "default": "invert",
          "enum": [
            "invert",
            "passthrough"
          ],
          "enumDescriptions": [
            "invert — 道Agent · 道德经直为前置 + 彻删官方一切着相之名 (身份/风格/规训) · 工具本身全保不动",
            "passthrough — 官方Agent · 锚归云 · 直连"
          ],
          "description": "首激默模 (二态互斥 · 无off)"
        },
        "dao.origin.banner": {
          "type": "boolean",
          "default": false,
          "description": "启动时显道德经横幅 (默认 false · 不言之教)"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.6.0"
  }
}